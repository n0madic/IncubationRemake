.DS_Store
.vscode/
__pycache__
_wip/
gog_incubation
tools/out
*.sav

# Godot editor cache, dev fixtures and export output (docs/92 section 3.2, section 10.1).
godot/.godot/
godot/generated/
# The converted game data every build carries inside its package (`make data`).
# Like generated/, it is reconstructed from the read-only retail data.
godot/data/
godot/export/

# The Wine harnesses' build products. Each is rebuilt from the committed
# source with one i686-w64-mingw32 command; see tools/dbgcall/README.md.
tools/dbgcall/*.exe
tools/wine_control/*.exe
tools/wine_visn/*.exe
tools/wine_visn/build/

# Native captures: derived from Blue Byte data, like tools/out/.
# The committed README.md beside them records what each one pins.
tests/fixtures/*/*.json
# The by-hand pass's screenshots (tests/fixtures/play/README.md): pictures of
# Blue Byte's art, filed per pass and never committed.
tests/fixtures/play/*/

# Machine-local Makefile settings (LANGUAGE_PACKS and the like).
local.mk
